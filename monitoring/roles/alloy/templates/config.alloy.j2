logging {
  level = "info"
}

livedebugging {
  enabled = true
}

{% for endpoint in alloy_loki_endpoints %}
loki.write "{{ endpoint.name }}" {
  endpoint {
    url = "{{ endpoint.url }}"
  }
}
{% endfor %}

{% for source in alloy_file_sources %}
local.file_match "{{ source.name }}_targets" {
  path_targets = [
{% for path in source.paths %}
    {
      __path__ = "{{ path }}",
{% for key, value in source.labels.items() %}
      {{ key }} = "{{ value }}",
{% endfor %}
    },
{% endfor %}
  ]
}

loki.source.file "{{ source.name }}" {
  targets    = local.file_match.{{ source.name }}_targets.targets
  forward_to = [
{% for endpoint in alloy_loki_endpoints %}
    loki.write.{{ endpoint.name }}.receiver,
{% endfor %}
  ]
}
{% endfor %}

{% for source in alloy_journal_sources %}
loki.source.journal "{{ source.name }}" {
  matches       = "{{ source.matches }}"
  format_as_json = false
  labels        = {
{% for key, value in source.labels.items() %}
    {{ key }} = "{{ value }}",
{% endfor %}
  }
  forward_to = [
{% for endpoint in alloy_loki_endpoints %}
    loki.write.{{ endpoint.name }}.receiver,
{% endfor %}
  ]
}
{% endfor %}

{% for source in alloy_syslog_sources %}
loki.source.syslog "{{ source.name }}" {
  listener {
    address       = "{{ source.listen_address }}"
    protocol      = "{{ source.protocol | default('udp') }}"
    syslog_format = "{{ source.syslog_format | default('rfc3164') }}"
    labels        = {
{% for key, value in source.labels.items() %}
      {{ key }} = "{{ value }}",
{% endfor %}
    }
  }
  forward_to = [loki.process.{{ source.name }}.receiver]
}

loki.process "{{ source.name }}" {
  forward_to = [
{% for endpoint in alloy_loki_endpoints %}
    loki.write.{{ endpoint.name }}.receiver,
{% endfor %}
  ]

  stage.regex {
    expression = "{{ source.keep_regex }}"
  }

  stage.drop {
    source              = "interesting"
    expression           = "^$"
    drop_counter_reason  = "not_in_allowlist"
  }
}
{% endfor %}
